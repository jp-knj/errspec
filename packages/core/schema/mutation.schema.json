{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jp-knj/errspec/main/packages/core/schema/mutation.schema.json",
  "title": "errspec mutation configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "node": {
      "type": "string",
      "minLength": 1
    },
    "vitestConfig": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "vitestProject": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "vitestPackage": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "typecheckProject": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "typecheckPackage": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludeMutator": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "ArithmeticOperator",
          "ArrayDeclaration",
          "ArrowFunction",
          "AssignmentOperator",
          "BlockStatement",
          "BooleanLiteral",
          "CallExpression",
          "ConditionalExpression",
          "EqualityOperator",
          "FnValue",
          "LogicalOperator",
          "MethodExpression",
          "ObjectLiteral",
          "OptionalChaining",
          "Regex",
          "StringLiteral",
          "UnaryOperator",
          "UpdateOperator"
        ]
      }
    },
    "failOnUndetected": {
      "type": "boolean"
    },
    "typecheck": {
      "type": "boolean"
    },
    "weakMutation": {
      "type": "boolean"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "only": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mutantsPerLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timeBudget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "failOnSurvived": {
          "type": "boolean"
        },
        "acceptedFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "thresholdHigh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "thresholdLow": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "thresholdBreak": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "since": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "diffUnit": {
      "enum": [
        "node",
        "scope",
        null
      ]
    },
    "reuseSession": {
      "type": "boolean"
    },
    "cache": {
      "type": "boolean"
    },
    "cacheRelocation": { "type": "boolean" },
    "cacheScope": { "type": "boolean" },
    "experimentalCallgraph": { "type": "boolean" },
    "fullDryRun": {
      "type": "boolean"
    },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
    "arid": { "type": "boolean" },
    "aridCallees": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
    "shard": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["index", "total"],
          "properties": {
            "index": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
            "total": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
          }
        }
      ]
    },
    "cacheDir": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "diffUnit"
        ],
        "properties": {
          "diffUnit": {
            "enum": [
              "node",
              "scope"
            ]
          }
        }
      },
      "then": {
        "required": [
          "since"
        ],
        "properties": {
          "since": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
